# Lokalnie: skopiuj do .env.local
# Vercel: Project → Settings → Environment Variables (Production + Preview)

# --- Adres strony (po deploy na darmowy *.vercel.app) ---
# NEXT_PUBLIC_SITE_URL=https://twoj-projekt.vercel.app

# Wyświetlany e-mail / odbiorca (nadpisuje content.ts → contact.email)
NEXT_PUBLIC_CONTACT_EMAIL=zelazowskimariusz91@gmail.com

# Automatyczna wysyłka formularza — DARMOWY plan Web3Forms:
# 1) https://web3forms.com → Create Access Key → wpisz ten sam e-mail co powyżej
# 2) Wklej klucz tutaj (TYLKO serwer — nie commituj .env.local!)
WEB3FORMS_ACCESS_KEY=

# Instagram (opcjonalnie)
# NEXT_PUBLIC_INSTAGRAM_USERNAME=odnowa.wewnetrzna
